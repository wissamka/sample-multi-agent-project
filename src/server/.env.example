DATABASE_URL=postgres://postgres:password@localhost:5432/personal_assistant
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
PORT=3000

# Assistant agent brain — leave ANTHROPIC_API_KEY empty to run fully offline
# with deterministic heuristics.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AGENT_EMAIL_DOMAIN=agent.local
